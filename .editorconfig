root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{mk,bp}]
indent_size = 4
indent_style = space

[*.xml]
indent_size = 4
indent_style = space

[*.sh]
indent_size = 4
indent_style = space
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
